<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lichii Builds" Width="412" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="Shell" Margin="16" CornerRadius="12" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource SurfaceLine}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>

            <!-- header -->
            <Grid Margin="18,16,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource LogoBrush}" VerticalAlignment="Center">
                    <TextBlock Text="L" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-2,0,0"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Lichii Builds" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="SubLine" Text="Starting" FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border x:Name="Pill" Grid.Column="2" CornerRadius="11" Padding="10,4" VerticalAlignment="Center" Background="#2A6CCB5F">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="#6CCB5F" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillText" Text="Up to date" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6CCB5F" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- new version of this app -->
            <Border x:Name="AppBanner" Visibility="Collapsed" Margin="12,0,12,8" CornerRadius="8" Padding="14,10" Background="#1A60CDFF"
                    BorderBrush="#3360CDFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource Icons}" FontSize="15" Foreground="#60CDFF" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppBannerTitle" Text="Lichii Builds is out" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="AppBannerText" Text="" FontSize="12" Foreground="{DynamicResource TextSub}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnAppUpdate" Grid.Column="2" Style="{DynamicResource AccentButton}" Padding="14,6" Content="Update" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- one card per repo -->
            <StackPanel x:Name="Cards" Margin="12,0,12,4"/>

            <Border Height="1" Background="#14FFFFFF" Margin="0,8,0,0"/>

            <!-- footer -->
            <Grid Margin="8,6,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnCheck" Style="{DynamicResource GhostButton}" ToolTip="Check GitHub for new builds now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CheckGlyph" Text="&#xE72C;" FontFamily="{DynamicResource Icons}" FontSize="13"
                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="CheckSpin" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Check now" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFolder" Style="{DynamicResource GhostButton}" ToolTip="Open the ZELDAOOT folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{DynamicResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FolderLabel" Text="ZELDAOOT" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSettings" Style="{DynamicResource GhostButton}" ToolTip="Settings" Padding="9,7">
                        <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Icons}" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnLog" Style="{DynamicResource GhostButton}" ToolTip="Open the log" Padding="9,7">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource Icons}" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnMore" Style="{DynamicResource GhostButton}" ToolTip="More" Padding="9,7">
                        <TextBlock Text="&#xE712;" FontFamily="{DynamicResource Icons}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
