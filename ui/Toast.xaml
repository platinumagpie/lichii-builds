<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lichii Builds" Width="412" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="Shell" Margin="16" CornerRadius="10" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource SurfaceLine}" BorderThickness="1" ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- colored edge: orange = new build, blue = working, green = done, red = problem -->
            <Border x:Name="Strip" Width="3" HorizontalAlignment="Left" Margin="7,16,0,16" CornerRadius="1.5" Background="#FFB454"/>

            <Grid Margin="18,14,10,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource LogoBrush}" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="L" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-2,0,0"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,6,0">
                    <TextBlock x:Name="Kicker" Text="LICHII BUILDS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock x:Name="TitleText" Text="Title" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BodyText" Text="Body" FontSize="12.5" Foreground="{DynamicResource TextSub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="MetaText" Text="" FontSize="11.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock x:Name="PhaseText" Text="Downloading" FontSize="12" Foreground="{DynamicResource TextSub}"/>
                            <TextBlock x:Name="PctText" Text="" FontSize="12" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="Bar" Style="{DynamicResource SlimBar}" Value="0" Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="Primary" Style="{DynamicResource AccentButton}" Content="OK"/>
                        <Button x:Name="Secondary" Style="{DynamicResource SubtleButton}" Content="Later" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="CloseBtn" Grid.Column="2" Style="{DynamicResource GhostButton}" Padding="7" VerticalAlignment="Top" ToolTip="Close">
                    <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Icons}" FontSize="10"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
